{
  "name": "neden",
  "private": true,
  "workspaces": [
    "apps/iina-plugin",
    "apps/website"
  ],
  "scripts": {
    "typecheck": "bun run --cwd apps/iina-plugin typecheck",
    "test": "bun run --cwd apps/iina-plugin test",
    "evals": "bun run --cwd apps/iina-plugin evals",
    "lint": "bun run --cwd apps/iina-plugin lint",
    "format": "bun run --cwd apps/iina-plugin format",
    "format:check": "bun run --cwd apps/iina-plugin format:check",
    "build": "bun run --cwd apps/iina-plugin build",
    "package": "bun run --cwd apps/iina-plugin package",
    "release:check": "bun run --cwd apps/iina-plugin release:check",
    "build:desktop": "sh scripts/desktop.sh build",
    "run:desktop": "sh scripts/desktop.sh run",
    "test:desktop": "sh scripts/desktop.sh test",
    "test:desktop:core": "sh scripts/desktop.sh core-test",
    "lint:desktop": "sh scripts/desktop.sh lint",
    "check:layout": "python3 scripts/check_layout.py",
    "install:desktop": "python3 scripts/install_desktop.py",
    "dev:website": "bun run --cwd apps/website dev",
    "build:website": "bun run --cwd apps/website build",
    "check:website": "bun run --cwd apps/website typecheck && bun run --cwd apps/website lint"
  }
}
