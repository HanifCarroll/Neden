---
import { buttonVariants } from "./ui/button"
interface Props {
  href: string
  variant?: "default" | "outline" | "ghost"
  class?: string
}
const { href, variant = "default", class: className } = Astro.props
---

<a
  href={href}
  class={buttonVariants({ variant, size: "marketing", className })}
>
  <slot />
</a>
