---
import "../styles/global.css"
interface Props {
  title?: string
  description?: string
}
const {
  title = "Neden — Stay in the story. Understand every word.",
  description = "A free, open-source video player for language learning. Watch with dual subtitles, look up words in context, and understand every line.",
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL("/images/player.webp", Astro.site)}
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <header class="site-container site-header">
      <a href="/" class="brand" aria-label="Neden home">
        <img src="/images/neden.webp" alt="" width="36" height="36" />
        <span>Neden</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/#how-it-works">How it works</a>
        <a href="/#downloads">Downloads</a>
        <a href="https://github.com/HanifCarroll/Neden">
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-container site-footer">
      <a href="/" class="brand">
        <img src="/images/neden.webp" alt="" width="28" height="28" />
        <span>Neden</span>
      </a>
      <div>
        <a href="https://github.com/HanifCarroll/Neden">GitHub</a>
        <a href="/privacy/">Privacy</a>
        <a href="https://hanifcarroll.com">Built by Hanif Carroll</a>
      </div>
    </footer>
  </body>
</html>
<style>
  .site-header {
    min-height: 96px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid var(--border);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--foreground);
    font-size: 22px;
    font-weight: 650;
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  nav,
  .site-footer div {
    display: flex;
    gap: 32px;
    align-items: center;
  }
  nav a,
  .site-footer div a {
    color: var(--muted-foreground);
    font-size: 14px;
    text-decoration: none;
  }
  nav a:hover,
  .site-footer div a:hover {
    color: var(--primary);
  }
  .site-footer {
    padding-block: 32px;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .site-footer .brand {
    font-size: 18px;
  }
  .skip-link {
    position: fixed;
    top: -100px;
    left: 20px;
    z-index: 10;
    background: white;
    padding: 16px;
  }
  .skip-link:focus {
    top: 12px;
  }
  @media (max-width: 640px) {
    .site-header {
      min-height: 80px;
      gap: 16px;
    }
    nav {
      gap: 16px;
    }
    nav a {
      font-size: 12px;
    }
    .brand {
      font-size: 19px;
      gap: 8px;
    }
    .brand img {
      width: 28px;
    }
    .site-footer {
      align-items: flex-start;
    }
    .site-footer div {
      flex-wrap: wrap;
      gap: 16px;
      justify-content: flex-end;
      max-width: 220px;
    }
  }
  @media (max-width: 380px) {
    nav {
      gap: 10px;
    }
    nav a {
      font-size: 11px;
    }
  }
</style>
